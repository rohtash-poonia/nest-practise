generator client {
  provider = "prisma-client-ts"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model gunjan {
  id            String @id @default(uuid())
  transactionId String @default("")
  utr           String @default("")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
